# --- Server ---
PORT=4000
NODE_ENV=development

# Absolute or relative path to the SQLite database file.
DATABASE_PATH=./data/villa.sqlite

# Secrets. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to boot in production if these are unset or left at the sample values.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Public URL of the app. Used for CORS and for the links in invitation emails,
# so it must match how people actually reach the site.
APP_URL=http://localhost:5173

# Directory of the built web client. When set, the API serves the SPA too and
# the whole app runs on one origin. The container image sets this itself.
# WEB_DIST=../web/dist

# Marks the refresh cookie Secure. Defaults to on in production. Set it to
# false ONLY for a deployment reached over plain HTTP (an IP with no
# certificate) — a Secure cookie is dropped there and sign-in fails silently.
# COOKIE_SECURE=true

# Reverse proxy hops in front of the app, for correct client IPs. 0 disables.
# TRUST_PROXY=1

# Local disk directory for receipt/message attachments.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Invitations are logged to stdout unless an SMTP transport is configured.
# SMTP_URL=smtp://user:pass@host:587
# MAIL_FROM="Villa Saya <no-reply@example.com>"
