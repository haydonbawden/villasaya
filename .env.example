# --- Server ---
PORT=4000
NODE_ENV=development

# Absolute or relative path to the SQLite database file.
DATABASE_PATH=./data/villa.sqlite

# Secrets. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to boot in production if these are unset or left at the sample values.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Where the web client is served from; used for CORS and invitation links.
APP_URL=http://localhost:5173

# Local disk directory for receipt/message attachments.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Invitations are logged to stdout unless an SMTP transport is configured.
# SMTP_URL=smtp://user:pass@host:587
# MAIL_FROM="Villa Staff Manager <no-reply@example.com>"
